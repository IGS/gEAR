#!/bin/bash
# Git pre-commit hook to auto-bump cache version in cache_version.json
# This ensures users always get the latest CSS/JS files
# Skip updating if cache_version is the only staged change (prevents infinite loops)

CACHE_FILE="www/cache_version.json"

# If the cache file has unstaged edits, skip bumping to avoid index/worktree divergence
# when pre-commit stashes and restores working tree changes.
if [ -f "$CACHE_FILE" ] && ! git diff --quiet -- "$CACHE_FILE"; then
    echo "ℹ Skipping cache_version bump (unstaged changes in $CACHE_FILE)"
    exit 0
fi

# Get list of staged files (excluding cache_version.json)
STAGED_FILES=$(git diff --cached --name-only | grep -v "^$CACHE_FILE$")

# If there are other staged files besides cache_version.json, proceed with version bump
if [ -n "$STAGED_FILES" ]; then
    if [ -f "$CACHE_FILE" ]; then
        # Get current version
        CURRENT_VERSION=$(grep -Po '"cache_version":\s*"\K[^"]*' "$CACHE_FILE")

        if [ -z "$CURRENT_VERSION" ]; then
            echo "Warning: cache_version not found in cache_version.json"
            exit 0
        fi

        # Generate new version using timestamp
        NEW_VERSION=$(date +"%Y.%m.%d.%H%M%S")

        # Update the version in the file
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # macOS
            sed -i '' "s/\"cache_version\": \"$CURRENT_VERSION\"/\"cache_version\": \"$NEW_VERSION\"/" "$CACHE_FILE"
        else
            # Linux
            sed -i "s/\"cache_version\": \"$CURRENT_VERSION\"/\"cache_version\": \"$NEW_VERSION\"/" "$CACHE_FILE"
        fi

        # Stage the updated file
        git add "$CACHE_FILE"

        echo "✓ Bumped cache_version: $CURRENT_VERSION → $NEW_VERSION"
    fi
else
    # Only cache_version.json is staged, skip the update to prevent infinite loops
    if git diff --cached "$CACHE_FILE" | grep -q "cache_version"; then
        echo "ℹ Skipping cache_version bump (only cache_version changed)"
    fi
fi

exit 0
