networks:
  gear:

services:
  db:
    environment:
      MYSQL_DATABASE: db
      MYSQL_USER: [user]
      MYSQL_PASSWORD: [pw]
      MYSQL_ROOT_PASSWORD: [pw]
    image: mysql:8.0-oracle  # for arm64v8 architecture
    networks:
      - gear
    ports:
      - "3306:3306"
    restart: always
    volumes:
      - db:/var/lib/mysql:rw

  web:
    depends_on:
      - db
    environment:
      - ENVIRONMENT=development # Set environment variable for development
    image: adkinsrs/umgear:latest
    networks:
      - gear
    ports:
      - "8080:80"
    pull_policy: always
    restart: on-failure
    volumes:
      - ..:/opt/gEAR/

  queue:
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "check_running"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 15s
    image: rabbitmq:4.1
    networks:
      - gear
    ports:
      - "5672:5672"
    restart: always

  panel:
    environment:
      - BOKEH_RESOURCES=cdn # Pull Bokeh library from CDN
    image: adkinsrs/spatial_panel_app:latest
    networks:
      - gear
    ports:
      - "5006:5006" # host:container
    pull_policy: always
    restart: always
    volumes:
      - <spatial_panel_cache_path>:/gEAR/www/cache/spatial_panel
      - <spatial_code_path>:/gEAR/services/spatial


  # ProjectR RabbitMQ Consumer
  #projectr_consumer:
  #  depends_on:
  #     queue:
  #      condition: service_healthy
  #  image: adkinsrs/gear_projectr_consumer:latest
  #  networks:
  #    - gear
  #  pull_policy: always
  #  restart: on-failure
  #  volumes:
  #    - ../listeners:/gEAR/listeners
  #    - ../lib:/gEAR/lib

  # TrackHub (Gosling Upload) RabbitMQ Consumer
  gosling_upload_consumer:
    depends_on:
      queue:
        condition: service_healthy
    environment:
      - ENVIRONMENT=development # Set environment variable for development
    image: adkinsrs/gear_gosling_upload_consumer:latest
    networks:
      - gear
    pull_policy: always
    restart: on-failure
    volumes:
      - ../listeners:/gEAR/listeners
      - ../lib:/gEAR/lib
      - ../www/uploads/files:/gEAR/www/uploads/files

  # AnnData object Upload RabbitMQ Consumer
  # i.e. h5ad, mex, tar
  anndata_upload_consumer:
    depends_on:
      queue:
        condition: service_healthy
    image: adkinsrs/gear_anndata_upload_consumer:latest
    networks:
      - gear
    pull_policy: always
    restart: on-failure
    volumes:
      - ../listeners:/gEAR/listeners
      - ../lib:/gEAR/lib
      - ../data:/gEAR/data
      - ../www/uploads/files:/gEAR/www/uploads/files

volumes:
  db:
    driver: local
    driver_opts:
      type: none
      device: ./mysql
      o: bind