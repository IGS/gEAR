[Unit]
Description=ProjectR Consumer Workers
Wants=projectr-consumer@1.service projectr-consumer@2.service projectr-consumer@3.service
# Wants= only pulls the workers in on start. PartOf= makes stop/restart of gear-consumers.target
# cascade down to this target (and from here to the workers, which are PartOf this target).
PartOf=gear-consumers.target

[Install]
WantedBy=multi-user.target