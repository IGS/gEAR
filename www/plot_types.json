    "violin": {"label": "Violin", "family": "plotly"},
    "tsne/umap_dynamic": {"label": "tSNE/UMAP dynamic", "family": "plotly", "aliases": ["tsne_dynamic", "tsne_dyna"], "full_width": true},

    "tsne_static": {"label": "tSNE static", "family": "scanpy", "aliases": ["tsne"], "basis": "tsne", "full_width": true},
    "umap_static": {"label": "UMAP static", "family": "scanpy", "basis": "umap", "full_width": true},
    "pca_static": {"label": "PCA static", "family": "scanpy", "basis": "pca", "full_width": true},

    "svg": {"label": "SVG image", "family": "svg"},
    "gosling": {"label": "Gosling", "family": "gosling"},
    "spatial_panel": {"label": "Spatial panel", "family": "spatial"},

    "dotplot": {"label": "Dotplot", "family": "mg_plotly"},
    "heatmap": {"label": "Heatmap", "family": "mg_plotly"},
    "mg_violin": {"label": "Violin", "family": "mg_plotly"},
    "quadrant": {"label": "Quadrant", "family": "mg_plotly"},
    "volcano": {"label": "Volcano", "family": "mg_plotly"},

    "mg_tsne_static": {"label": "tSNE", "family": "mg_scanpy", "basis": "tsne", "full_width": true},
    "mg_umap_static": {"label": "UMAP", "family": "mg_scanpy", "basis": "umap", "full_width": true},
    "mg_pca_static": {"label": "PCA", "family": "mg_scanpy", "basis": "pca", "full_width": true}
  }
